{
  "name": "@openasy/expenses",
  "version": "0.1.0",
  "private": true,
  "description": "OpenAsy Expenses: receipts, claims and approvals by the rules in a file, with TCMB rates, KDV, card statements, reimbursement batches and exports for the accountant.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/openasy/expenses.git"
  },
  "scripts": {
    "start": "node server/main.ts",
    "build": "node scripts/build-docs.ts",
    "openapi": "node scripts/openapi.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run"
  },
  "prettier": "@openasy/code-style/prettier",
  "devDependencies": {
    "@openasy/code-style": "https://github.com/openasy/code-style/releases/download/v0.1.2/openasy-code-style-0.1.2.tgz",
    "@types/node": "^26.6.5",
    "ajv": "^8.20.0",
    "jpeg-js": "^0.4.4",
    "oxlint": "1.87.0",
    "prettier": "3.9.10",
    "swagger-ui-dist": "^5.34.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.12.0",
    "npm": ">=11"
  },
  "dependencies": {
    "@openasy/auth": "https://github.com/openasy/auth/releases/download/v0.11.1/openasy-auth-0.11.1.tgz",
    "yaml": "^2.9.1"
  }
}
